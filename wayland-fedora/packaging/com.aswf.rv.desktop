[Desktop Entry]
Type=Application
Version=1.0
Name=OpenRV
GenericName=Media Player and Review Tool
Comment=Play and review image sequences, movies and EXR/DPX/TIFF/JPEG frames
Exec=rv %F
TryExec=rv
Icon=openrv
Terminal=false
Categories=AudioVideo;Video;Graphics;
MimeType=video/mp4;video/quicktime;video/x-matroska;video/x-msvideo;video/mpeg;video/x-m4v;image/jpeg;image/png;image/tiff;image/x-exr;image/x-dpx;image/x-hdr;image/x-tga;image/bmp;image/gif;image/x-portable-pixmap;image/x-sgi;
StartupWMClass=com.aswf.rv
StartupNotify=false
Keywords=video;image;sequence;review;exr;
